venv/
.venv/
env/
ENV/

# Node / frontend
node_modules/
dist/
dist-ssr/
*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Secrets
.env
.env.*
!.env.example

# ML training output & runtime-generated media (keep code + model, not artifacts)
detection_sandbox/runs/
lookout_backend/media/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Auto-downloaded YOLO base weights (fetched on first use, don't commit)
yolov8n.pt
yolov8n-pose.pt
lookout_backend/yolov8n.pt
lookout_backend/yolov8n-pose.pt

# Continuous CCTV recordings and recorder runtime state
cctv records/
cctv records/recorder.log

# Local test artifacts
lookout_backend/_*.jpg

# Test footage - too large for git (Aug14_17.mkv is 452MB, GitHub caps at 100MB)
*.mkv
*.mp4
*.avi

# Django collectstatic output (regenerated on every deploy)
staticfiles/

# --- local database ---------------------------------------------------------
# Untracked deliberately. It was committed up to 092fa72 "for full portability",
# but it carries SystemSettings.vlm_api_key -- a live Gemini credential -- so
# every commit was publishing it. Each developer now keeps their own:
#   python manage.py migrate && python manage.py seed_demo
*.sqlite3
*.sqlite3-journal

# Word lock files (created while a .docx is open, meaningless to anyone else)
~$*.docx
# Local backup of src/ taken before the font-size pass
.font-bump-backup-src/

# Local model copies. core/vision/merged.pt is the one the detectors load and
# is tracked; these two are duplicates of it.
#   merged_v2_best.pt       the same weights as pulled from models/merged-v2
#   *_v1_backup.pt          a rollback copy, recoverable from history
# args.yaml and results.csv ARE kept: they are small and they are the only
# record of how the deployed weights were trained.
/merged_v2_best.pt
*_v1_backup.pt

# Recorder process id file
lookout_backend/recorder.pid

# Local database / file backups (keep out of git)
*.sqlite3.*
*.sqlite3-*
*.bak
*.bak-*
*.backup
*.pt.bak*
