    "vision/ai_checker.py": {
      "DEFAULT_MODEL": "qwen3-vl:2b-instruct",
      "DEFAULT_ENDPOINT": "http://localhost:11434",
      "DEFAULT_TIMEOUT": 90.0,
      "TOKENS_PER_IMAGE": 1200,
      "PROMPT_TOKENS": 2500,
      "MAX_TOKENS": 400,
      "FRAMES_DEFAULT": 8,
      "FRAMES_BEFORE": 5.0,
      "FRAMES_AFTER": 1.0,
      "RING_SECONDS": 7.0,
      "AI_SPREAD_FRAMES": true,
      "OBJECT_FRAME_SHARE": 0.5,
      "OBJECT_FRAME_GAP": 0.3,
      "OBJECT_CLASSES": [
        "cigarette",
        "bottle",
        "knife"
      ],
      "RING_MIN_GAP": 0.15,
      "SEND_EDGE": 640,
      "MIN_EDGE": 0,
      "JPEG_QUALITY_RING": 90,
      "JPEG_QUALITY_SEND": 88,
      "SHARED_INSTRUCTIONS": "You are reviewing a short CCTV video from a barangay street camera in the Philippines.\nThe video is cropped around the person or group of interest. The frames are in time order.\nSystem detections (from the object and pose models): {system_note}\nDescribe what you see first, then answer.\nFor true/false fields about objects, answer true only if you can see them.\nFor likelihood and choice fields, give your best judgment from what is visible.\nPick \"unclear\" if you cannot tell.\nRate confidence: \"high\" if the evidence is clearly visible, \"medium\" if it is\npartly visible or you are partly sure, \"low\" if you are mostly guessing.\nReply only with the JSON below. No other text.",
      "BLOCKS": {
        "drinking": "{\n\"observations\": \"one sentence, under 20 words, only what you see\",\n\"drinking_likelihood\": \"likely\" | \"possible\" | \"unlikely\",\n\"table_chairs_or_seating_visible\": true/false,\n\"drinking_items_visible\": true/false,\n\"scene_type\": \"drinking_session\" | \"other_activity\" | \"unclear\",\n\"confidence\": \"high\" | \"medium\" | \"low\"\n}\nDefinitions:\n- observations: the people, objects and actions you can see. No conclusions.\n- drinking_likelihood: how likely it is that people are drinking at this spot.\n\"likely\" = someone drinks from a bottle, can or cup, or drinks are shared;\n\"possible\" = people are gathered with drinks nearby, but no drinking is seen;\n\"unlikely\" = no sign of drinking.\n- table_chairs_or_seating_visible: chairs, stools, benches, or a table used by the people.\n- drinking_items_visible: drinks, glasses, cups, plates or snacks set down near the people.\n- scene_type: \"drinking_session\" if people are drinking or gathered with drinks;\n\"other_activity\" ONLY if you can clearly see an ordinary activity, such as a store\nselling drinks, someone carrying or delivering drinks, or people eating a meal.\nVehicles or people passing in the background do not count;\n\"unclear\" if you cannot tell.",
        "smoking": "{\n\"observations\": \"one sentence, under 20 words, only what you see\",\n\"smoking_item_visible\": true/false,\n\"hand_to_mouth_activity\": \"smoking\" | \"other_activity\" | \"none\" | \"unclear\",\n\"confidence\": \"high\" | \"medium\" | \"low\"\n}\nDefinitions:\n- observations: the person's hands, what they hold, and what they do. If smoke or vapor\nis clearly leaving the person's mouth, nose, or a held item, mention it; otherwise do\nnot mention smoke. No conclusions.\n- smoking_item_visible: a small thin object (cigarette) or a small device (vape)\nheld between the fingers or at the lips.\n- hand_to_mouth_activity: what the hand is doing when it is at the mouth.\n\"smoking\" = fingers held together at the lips briefly, then the hand moves away;\nmay hold a small thin object or exhale smoke;\n\"other_activity\" = an ordinary reason, such as eating, drinking from a bottle or cup,\nusing a phone, or wiping the face;\n\"none\" = the hand never reaches the mouth;\n\"unclear\" = you cannot tell.",
        "holdup": "{\n\"observations\": \"one sentence, under 20 words, only what you see\",\n\"people_count\": integer,\n\"object_pointed_at_a_person\": true/false,\n\"victim_response_visible\": true/false,\n\"holdup_likelihood\": \"likely\" | \"possible\" | \"unlikely\",\n\"scene_type\": \"confrontation\" | \"other_activity\" | \"unclear\",\n\"confidence\": \"high\" | \"medium\" | \"low\"\n}\nDefinitions:\n- observations: the people, the object, and how they act toward each other. No conclusions.\n- people_count: the number of distinct real people you can see in the frames, as a whole number.\nShadows, reflections, posters and mannequins are not people. Count a person once even if they\nappear in several frames.\n- object_pointed_at_a_person: a knife or sharp object is pointed or held toward another person.\n- victim_response_visible: a person raising their hands, handing over items, or backing away.\n- holdup_likelihood: how likely it is that one person is robbing or threatening another.\n\"likely\" = threatening behaviour is visible; \"possible\" = tense or unusual, but no clear threat;\n\"unlikely\" = no sign of a threat.\n- scene_type: \"confrontation\" if one person appears to be threatening another;\n\"other_activity\" ONLY if you can clearly see ordinary use of the object, such as vending,\nfood preparation, work, or play; \"unclear\" if you cannot tell."
      },
      "KINDS": "EXPR: tuple(BLOCKS)",
      "_ENUMS": {
        "drinking_likelihood": [
          "likely",
          "possible",
          "unlikely"
        ],
        "holdup_likelihood": [
          "likely",
          "possible",
          "unlikely"
        ],
        "scene_type": {
          "drinking": [
            "drinking_session",
            "other_activity",
            "unclear"
          ],
          "holdup": [
            "confrontation",
            "other_activity",
            "unclear"
          ]
        },
        "hand_to_mouth_activity": [
          "smoking",
          "other_activity",
          "none",
          "unclear"
        ],
        "confidence": [
          "high",
          "medium",
          "low"
        ]
      },
      "UNPRIMED_KINDS": [
        "holdup"
      ],
      "UNPRIMED_INSTRUCTIONS": "EXPR: \"\\n\".join(line for line in SHARED_INSTRUCTIONS.splitlines()\n                                  if not line.startswith(\"System detections\"))",
      "CROP_PAD": {
        "smoking": 0.25,
