# Copy to .env and fill in. Read by python-decouple; lists use comma-separated
# values (Csv), with NO spaces after the commas.

# --- core -------------------------------------------------------------------
SECRET_KEY=change-me-run-python-c-import-secrets-print-secrets.token_urlsafe(50)
DEBUG=False

# Hosts this server answers for. NO DEFAULT AND NO WILDCARD: leave it unset and
# Django rejects every request. That is deliberate - a forgotten value should
# cause an obvious outage, not a server that quietly accepts any Host header.
ALLOWED_HOSTS=api.example.com

# --- database ---------------------------------------------------------------
# Option 1: a single URL. Render and DigitalOcean inject this automatically.
DATABASE_URL=postgresql://user:password@host:5432/lookout

# Option 2: discrete values, used only when DATABASE_URL is unset.
# DB_NAME=lookout
# DB_USER=lookout
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
# DB_SSLMODE=require

# Local offline work without a Postgres server. Opt-in only.
# USE_SQLITE=True

# --- CORS -------------------------------------------------------------------
# Origins allowed to call this API from a browser. Empty means none.
CORS_ALLOWED_ORIGINS=https://lookout-bice.vercel.app,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://lookout-bice.vercel.app
# Override only if a client starts sending a custom header.
# CORS_ALLOW_HEADERS=accept,authorization,content-type,origin,x-csrftoken
# CORS_ALLOW_METHODS=DELETE,GET,OPTIONS,PATCH,POST,PUT

# --- evidence media (S3-compatible: Cloudflare R2, Spaces, S3) --------------
# Must match what the on-site detection PC uses, or alert images will 404.
AWS_STORAGE_BUCKET_NAME=lookout-media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
AWS_S3_CUSTOM_DOMAIN=<public-bucket-host-no-scheme>

# --- camera ----------------------------------------------------------------
# RTSP URL of the one camera (CAM-SMOKE-01). Set this in the .env of the
# machine that can actually reach the camera -- the on-site detection PC.
# Leave it unset on a hosted API, which cannot route to a LAN address anyway.
#
# A stream URL saved from Live Feeds takes priority over this, so setting it
# here never overrides what an operator typed. Credentials go in the URL, so
# treat this .env as a secret.
# STREAM_URL=rtsp://user:pass@192.168.1.64:554/Streaming/Channels/101

# Where THIS machine reaches Ollama for the VLM check. Overrides the stored
# SystemSettings.vlm_endpoint, which is one shared row and so cannot be right
# for the edge PC and a hosted API at once. Leave unset to use the stored one.
#   edge PC  : unset (localhost:11434)
#   hosted   : the tunnel fronting the edge PC's Ollama
# Ollama binds 127.0.0.1 and checks the Host header, so exposing it needs
# OLLAMA_HOST=0.0.0.0:11434 and `ngrok http 11434 --host-header=rewrite`.
# VLM_ENDPOINT=https://your-tunnel.ngrok-free.dev

# --- email (OTP codes) via the Brevo HTTP API ------------------------------
# Default. Preferred over SMTP because managed hosts block outbound SMTP ports,
# and an API rejection names its cause where a 535 does not. See core/mail.py.
BREVO_API_KEY=xkeysib-...
# BREVO_TIMEOUT=15

# Optional: fall back to the SMTP relay instead.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#
# Those settings, used only in that case. Note the SMTP relay needs a DIFFERENT
# credential -- an SMTP key (xsmtpsib-...), not the API key above -- and a login
# from Brevo -> SMTP & API -> SMTP, which is NOT your account email.
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=9a1b2c001@smtp-brevo.com
# EMAIL_HOST_PASSWORD=xsmtpsib-...

# Must be an address verified under Brevo -> Senders. No longer defaults to
# EMAIL_HOST_USER: an @smtp-brevo.com login is a credential, not a mailbox, and
# mail sent From: it is dropped as an unverified sender.
DEFAULT_FROM_EMAIL=noreply@yourdomain.example

# If Brevo -> Security -> Authorised IPs is enabled, the sending host's IP must
# be listed there or sending fails whatever the credentials are -- 401 on the
# API, 535 over SMTP. Add the production host's egress IP, or turn it off.
# NOTE this gates BOTH routes; switching to the API does not avoid it.
